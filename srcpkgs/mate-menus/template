# Template file for 'mate-menus'
pkgname=mate-menus
version=1.28.1
revision=1
build_style=gnu-configure
build_helper="gir"
configure_args="--disable-static"
hostmakedepends="pkg-config gettext itstool $(vopt_if gir gobject-introspection)"
makedepends="libglib-devel"
short_desc="MATE menu specifications"
maintainer="Orphaned <orphan@voidlinux.org>"
license="GPL-2.0-or-later, LGPL-2.0-or-later"
homepage="https://mate-desktop.org"
changelog="https://raw.githubusercontent.com/mate-desktop/mate-menus/master/NEWS"
distfiles="https://github.com/mate-desktop/mate-menus/releases/download/v${version}/mate-menus-${version}.tar.xz"
checksum=d6a61d3bfbf58176fb52049f115d4e3a0d108fe5f1ef87438fafd86384e603d1

build_options="gir"
build_options_default="gir"

mate-menus-devel_package() {
	short_desc+=" - development files"
	depends="${sourcepkg}>=${version}_${revision}"
	pkg_install() {
		vmove usr/include
		vmove usr/lib/*.so
		vmove usr/lib/pkgconfig
		if [ "$build_option_gir" ]; then
			vmove usr/share/gir-1.0
		fi
	}
}
